{
  "deps": [
    {
      "id": "rix/rix",
      "version": "0.9.1"
    }
  ],
  "description": "Production backend for Softadastra Cloud.",
  "license": "MIT",
  "name": "cloud",
  "production": {
    "database": {
      "engine": "sqlite",
      "migrations": "migrations",
      "sqlite_path": "storage/cloud.db"
    },
    "deploy": {
      "branch": "main",
      "build": "vix build --preset release",
      "health_local": true,
      "health_public": false,
      "log_lines": 80,
      "logs_on_failure": true,
      "proxy_check": true,
      "proxy_reload": false,
      "pull": true,
      "rollback": false,
      "service": "cloud",
      "test_command": "vix tests",
      "tests": false
    },
    "env": {
      "required": [
        "APP_NAME",
        "APP_ENV",
        "SERVER_PORT",
        "DATABASE_ENGINE",
        "DATABASE_SQLITE_PATH",
        "CORS_ALLOWED_ORIGINS"
      ]
    },
    "health": {
      "expected_status": 200,
      "local": "http://127.0.0.1:8080/health",
      "max_response_ms": 1000,
      "public": "https://api.softadastra.com/health",
      "service": "cloud",
      "timeout_ms": 2000,
      "websocket": "wss://api.softadastra.com/ws"
    },
    "logs": {
      "lines": 120,
      "nginx_access": "/var/log/nginx/cloud.access.log",
      "nginx_error": "/var/log/nginx/cloud.error.log",
      "service": "cloud"
    },
    "ports": {
      "http": 8080,
      "websocket": 9090
    },
    "proxy": {
      "domain": "api.softadastra.com",
      "http": {
        "port": 8080
      },
      "tls": {
        "certificate": "/etc/letsencrypt/live/api.softadastra.com/fullchain.pem",
        "certificate_key": "/etc/letsencrypt/live/api.softadastra.com/privkey.pem",
        "enabled": true
      },
      "websocket": {
        "enabled": true,
        "path": "/ws",
        "port": 9090
      }
    },
    "service": {
      "environment": {
        "VIX_CLI_PATH": "/home/gaspard/.local/bin/vix"
      },
      "exec": "/home/gaspard/softadastra/cloud/build-release/bin/cloud",
      "limit_nofile": 65535,
      "name": "cloud",
      "restart": "always",
      "restart_sec": 3,
      "user": "gaspard",
      "working_dir": "/home/gaspard/softadastra/cloud"
    },
    "websocket": {
      "heartbeat": true,
      "host": "127.0.0.1",
      "local_url": "ws://127.0.0.1:9090/ws",
      "path": "/ws",
      "port": 9090,
      "public_url": "wss://api.softadastra.com/ws",
      "timeout_ms": 5000
    }
  },
  "tasks": {
    "build": "vix build --preset release",
    "check": "vix check --tests --run",
    "deploy": "vix deploy",
    "dev": "vix dev",
    "doctor": "vix doctor production",
    "env": "vix env check",
    "health": "vix health",
    "logs": "vix logs",
    "orm:migrate": "vix orm migrate",
    "orm:rollback": "vix orm rollback --steps 1",
    "orm:status": "vix orm status",
    "proxy": "vix proxy nginx check",
    "service": "vix service status",
    "test": "vix tests"
  },
  "template": "backend",
  "type": "application",
  "version": "0.1.0"
}
