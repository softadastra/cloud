name = "realtime"
kind = "backend"
workflow = "websocket.attached"
runtime = true

[routes]
prefix = "/ws"

[websocket]
workflow = "attached"
path = "/ws"
host = "0.0.0.0"
port = 9090
long_polling = false
metrics = false

[deps]
registry = []

links = [
  "vix::websocket",
]

[tests]
enabled = true
