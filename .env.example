# ----------------------------------
# Softadastra Cloud
# ----------------------------------
CLOUD_SERVICE_NAME=softadastra-cloud
CLOUD_ENVIRONMENT=development

# ----------------------------------
# Server
# ----------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# ----------------------------------
# Frontend / CORS
# ----------------------------------
CLOUD_CORS_ALLOWED_ORIGIN=http://localhost:5173

# ----------------------------------
# Development
# ----------------------------------
CLOUD_DEV_MODE=true
CLOUD_AUTO_MIGRATE=true
CLOUD_MAX_REQUEST_BODY_BYTES=1048576

# ----------------------------------
# Database
# ----------------------------------
DATABASE_ENGINE=mysql
DATABASE_DEFAULT_HOST=127.0.0.1
DATABASE_DEFAULT_PORT=3306
DATABASE_DEFAULT_USER=root
DATABASE_DEFAULT_PASSWORD=
DATABASE_DEFAULT_NAME=softadastra_cloud

# ----------------------------------
# Logging
# ----------------------------------
LOGGING_ASYNC=true

# ----------------------------------
# Security / Tokens
# ----------------------------------
CLOUD_JWT_SECRET=change-me-in-production
CLOUD_AGENT_API_KEY_SECRET=change-me-in-production

# ----------------------------------
# Security / WAF
# ----------------------------------
WAF_MODE=basic
